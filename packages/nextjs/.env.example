NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# --- Optional HCS audit mirror (server-side only, never NEXT_PUBLIC_) ---
# Leave all three unset to run with the audit mirror disabled.
# Operator account (0.0.x) with an ECDSA key, funded with testnet HBAR.
HEDERA_OPERATOR_ID=
# ECDSA private key (hex) for HEDERA_OPERATOR_ID. Never commit this file with a real key.
HEDERA_OPERATOR_KEY=
# HCS topic (0.0.x). Create it once: npm run audit:create-topic
HEDERA_AUDIT_TOPIC_ID=
# testnet (default) or mainnet
HEDERA_NETWORK=testnet
