# Hedera JSON-RPC endpoint (testnet default, change for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. Run npm run generate or npm run account:import first.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# MilestoneEscrow: Chainlink AggregatorV3 feed address (optional).
# Defaults: local networks deploy a MockPriceFeed at $0.10; other networks
# use the Hedera testnet HBAR/USD feed.
PRICE_FEED_ADDRESS=
# Max Chainlink round age in seconds accepted when funding (default 10800).
MAX_STALENESS_SECONDS=
